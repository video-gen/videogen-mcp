{
  "name": "@videogen/mcp",
  "version": "2.0.18",
  "description": "Model Context Protocol server for the VideoGen API. Generate videos, images, voiceovers, and more from any MCP client.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "videogen-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.widget.config.ts",
    "build:js": "tsup && tsup --config tsup.widget.config.ts",
    "build:widget": "tsup --config tsup.widget.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "start:http": "VIDEOGEN_BASE_URL=\"${VIDEOGEN_BASE_URL:-http://localhost:4010}\" VIDEOGEN_OAUTH_ISSUER=\"${VIDEOGEN_OAUTH_ISSUER:-http://127.0.0.1:54321/auth/v1}\" node dist/http.js",
    "smoke": "node dist/smoke.js",
    "pretest": "pnpm build",
    "test": "node --import ./test/register.mjs --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@videogen/sdk": "^2.0.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.19.4",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.14.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsup": "^8.5.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.13.0"
  }
}
